# ─── LLM 配置 ───
# 兼容 deepseek / openai / siliconflow 等 OpenAI 兼容接口
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ─── Redis 配置（短期记忆 + PlanStore 持久化）───
REDIS_URL=redis://localhost:6379/0

# ─── Docker 沙箱配置 ───
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=100000
SANDBOX_TIMEOUT=300

# ─── GitHub 配置（搜 repo 用）───
# 申请：GitHub Settings → Developer settings → Personal access tokens → 勾选 public_repo
GITHUB_TOKEN=github_pat_xxx

# ─── API 配置 ───
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]  # list 类型必须 JSON 数组格式，或逗号分隔见 config.py validator

# ─── 日志 ───
LOG_LEVEL=INFO
